{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/blogcommand",
      "destination": "/blogcommand/index.html"
    },
    {
      "source": "/blogcommand/(.*)",
      "destination": "/blogcommand/$1"
    },
    {
      "source": "/((?!api/|blogcommand/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
